---
import Preloader from "../components/Preloader.astro"
import ScrollButton from "../components/ScrollButton.astro"

interface Props {
	title: string
	description?: string
}

const { title, description = "Kevin Alberto Villatoro Arroyo | Portafolio Profesional" } = Astro.props
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#f9fafb" />
		<script is:inline>
			(function() {
				var stored = localStorage.getItem('theme');
				var prefersLight = window.matchMedia('(prefers-color-scheme: light)').matches;
				var theme = stored || (prefersLight ? 'light' : 'light');
				document.documentElement.setAttribute('data-theme', theme);
				document.querySelector('meta[name="theme-color"]').content = theme === 'light' ? '#f9fafb' : '#0a0a0f';
			})();
		</script>

		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content="https://kevin-villatoro-dev.github.io/og-image-github.jpg" />
		<meta property="og:url" content="https://kevin-villatoro-dev.github.io" />
		<meta property="og:site_name" content="Kevin Alberto Villatoro Arroyo" />

		<!-- Twitter/X Cards -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content="https://kevin-villatoro-dev.github.io/og-image-github.jpg" />
		<link rel="canonical" href="https://kevin-villatoro-dev.github.io" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="preload"
			href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&display=swap"
			as="style"
			onload="this.onload=null;this.rel='stylesheet'"
		/>
		<noscript>
			<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet" />
		</noscript>
		<title>{title}</title>
		<!-- Google tag (gtag.js) -->
		<script async src="https://www.googletagmanager.com/gtag/js?id=G-CRPBDXBYQG"></script>
		<script>
			window.dataLayer = window.dataLayer || []
			function gtag() {
				dataLayer.push(arguments)
			}
			gtag("js", new Date())

			gtag("config", "G-CRPBDXBYQG")
		</script>
	</head>
	<body>
		<Preloader />
		<div class="shapes" id="shapes"></div>
		<slot />
		<ScrollButton />
	</body>

	<script is:inline>
		const container = document.getElementById("shapes")
		const isLight = document.documentElement.getAttribute("data-theme") === "light"
		const colors = isLight ? ["#C9A227", "#1E3A8A"] : ["#00d4ff", "#ff00aa"]
		const shapes = ["circle", "square", "triangle", "hexagon"]

		for (let i = 0; i < 12; i++) {
			const shape = shapes[Math.floor(Math.random() * shapes.length)]
			const el = document.createElement("div")
			el.className = `shape shape--${shape}`

			const size = Math.random() * 25 + 12
			const color = colors[Math.floor(Math.random() * colors.length)]

			if (shape === "circle" || shape === "square") {
				el.style.width = size + "px"
				el.style.height = size + "px"
				el.style.borderColor = color
			} else if (shape === "triangle") {
				el.style.borderBottomColor = color
			} else {
				el.style.width = size + "px"
				el.style.height = size + "px"
				el.style.background = color
			}

			el.style.left = Math.random() * 100 + "%"
			el.style.animationDuration = Math.random() * 25 + 20 + "s"
			el.style.animationDelay = Math.random() * 15 + "s"
			container.appendChild(el)
		}
	</script>
</html>

<style is:global>
	@import "../styles/global.css";
</style>

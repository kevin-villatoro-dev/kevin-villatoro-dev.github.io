---

<div class="theme-modal" id="theme-modal">
	<div class="theme-modal-bg"></div>
	<div class="theme-modal-content">
		<div class="theme-modal-header">
			<h2 class="theme-modal-title">Bienvenido</h2>
			<p class="theme-modal-subtitle">
				La primera impresión también se diseña, Hagámoslo a tu manera
				<br />
				¡La experiencia comienza contigo!
			</p>
		</div>
		<div class="theme-cards">
			<button class="theme-card dark-card" data-theme="dark" aria-label="Modo Nocturno">
				<div class="card-preview">
					<div class="preview-header">
						<div class="preview-dots">
							<span></span><span></span><span></span>
						</div>
						<div class="preview-nav">
							<span></span><span></span><span></span>
						</div>
					</div>
					<div class="preview-hero">
						<div class="preview-name"></div>
						<div class="preview-subtitle"></div>
						<div class="preview-buttons">
							<span class="preview-btn primary"></span>
							<span class="preview-btn secondary"></span>
						</div>
					</div>
					<div class="preview-cards">
						<div class="preview-card"></div>
						<div class="preview-card"></div>
						<div class="preview-card"></div>
					</div>
				</div>
				<div class="card-label">
					<svg class="card-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
					</svg>
					<span>Modo Nocturno</span>
				</div>
			</button>
			<button class="theme-card light-card" data-theme="light" aria-label="Modo Lumina">
				<div class="card-preview">
					<div class="preview-header">
						<div class="preview-dots">
							<span></span><span></span><span></span>
						</div>
						<div class="preview-nav">
							<span></span><span></span><span></span>
						</div>
					</div>
					<div class="preview-hero">
						<div class="preview-name"></div>
						<div class="preview-subtitle"></div>
						<div class="preview-buttons">
							<span class="preview-btn primary"></span>
							<span class="preview-btn secondary"></span>
						</div>
					</div>
					<div class="preview-cards">
						<div class="preview-card"></div>
						<div class="preview-card"></div>
						<div class="preview-card"></div>
					</div>
				</div>
				<div class="card-label">
					<svg class="card-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<circle cx="12" cy="12" r="5"></circle>
						<line x1="12" y1="1" x2="12" y2="3"></line>
						<line x1="12" y1="21" x2="12" y2="23"></line>
						<line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
						<line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
						<line x1="1" y1="12" x2="3" y2="12"></line>
						<line x1="21" y1="12" x2="23" y2="12"></line>
						<line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
						<line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
					</svg>
					<span>Modo Lumina</span>
				</div>
			</button>
		</div>
	</div>
</div>

<style>
	.theme-modal {
		position: fixed;
		inset: 0;
		z-index: 10000;
		display: flex;
		align-items: center;
		justify-content: center;
		opacity: 0;
		visibility: hidden;
		transition:
			opacity 0.4s ease,
			visibility 0.4s ease;
	}

	.theme-modal.visible {
		opacity: 1;
		visibility: visible;
	}

	.theme-modal.exiting {
		pointer-events: none;
	}

	.theme-modal.exiting .theme-modal-content {
		animation: modalContentExit 0.5s ease forwards;
	}

	@keyframes modalContentExit {
		0% {
			transform: scale(1);
			opacity: 1;
		}
		100% {
			transform: scale(0.95);
			opacity: 0;
		}
	}

	.theme-modal-bg {
		position: absolute;
		inset: 0;
		background: rgba(10, 10, 15, 0.92);
		backdrop-filter: blur(30px);
		-webkit-backdrop-filter: blur(30px);
		transition: background 0.6s ease;
	}

	.theme-modal.previewing-dark .theme-modal-bg {
		background: rgba(10, 10, 15, 0.97);
	}

	.theme-modal.previewing-light .theme-modal-bg {
		background: rgba(249, 250, 251, 0.97);
	}

	.theme-modal-content {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 3rem;
		padding: 2rem;
	}

	.theme-modal-header {
		text-align: center;
	}

	.theme-modal-title {
		font-family: var(--font-heading);
		font-size: clamp(1.5rem, 4vw, 2.2rem);
		font-weight: 700;
		color: #f0f0f5;
		margin: 0 0 0.5rem;
		transition: color 0.6s ease;
	}

	.theme-modal.previewing-light .theme-modal-title {
		color: #1c1917;
	}

	.theme-modal-subtitle {
		font-size: clamp(0.9rem, 2vw, 1.1rem);
		color: #a0a0b0;
		margin: 0;
		transition: color 0.6s ease;
	}

	.theme-modal.previewing-light .theme-modal-subtitle {
		color: #57534e;
	}

	.theme-cards {
		display: flex;
		gap: 2rem;
		align-items: stretch;
	}

	.theme-card {
		position: relative;
		width: 240px;
		background: rgba(255, 255, 255, 0.04);
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: 16px;
		padding: 1rem;
		cursor: pointer;
		transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
		overflow: hidden;
		font-family: inherit;
	}

	.theme-card::before {
		content: "";
		position: absolute;
		inset: 0;
		border-radius: 16px;
		padding: 1px;
		background: linear-gradient(135deg, transparent, transparent);
		-webkit-mask:
			linear-gradient(#fff 0 0) content-box,
			linear-gradient(#fff 0 0);
		mask:
			linear-gradient(#fff 0 0) content-box,
			linear-gradient(#fff 0 0);
		-webkit-mask-composite: xor;
		mask-composite: exclude;
		transition: background 0.4s ease;
		pointer-events: none;
	}

	.dark-card:hover::before {
		background: linear-gradient(135deg, #00d4ff, #ff00aa);
	}

	.light-card::before {
		background: linear-gradient(135deg, rgba(201, 162, 39, 0.4), rgba(30, 58, 138, 0.4));
	}

	.light-card:hover::before {
		background: linear-gradient(135deg, #c9a227, #1e3a8a);
	}

	.dark-card:hover {
		transform: translateY(-8px) scale(1.02);
		box-shadow: 0 20px 60px rgba(0, 212, 255, 0.2);
		background: rgba(255, 255, 255, 0.06);
	}

	.light-card {
		transform: translateY(-4px);
		box-shadow: 0 12px 40px rgba(201, 162, 39, 0.15);
		background: rgba(255, 255, 255, 0.6);
	}

	.light-card:hover {
		transform: translateY(-8px) scale(1.02);
		box-shadow: 0 20px 60px rgba(201, 162, 39, 0.25);
		background: rgba(255, 255, 255, 0.8);
	}

	.card-preview {
		background: #0a0a0f;
		border-radius: 10px;
		padding: 0.75rem;
		margin-bottom: 1rem;
		height: 180px;
		overflow: hidden;
		transition: background 0.6s ease;
	}

	.light-card .card-preview {
		background: #f9fafb;
	}

	.preview-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 1.25rem;
		padding-bottom: 0.5rem;
		border-bottom: 1px solid rgba(255, 255, 255, 0.06);
	}

	.light-card .preview-header {
		border-bottom-color: rgba(0, 0, 0, 0.06);
	}

	.preview-dots {
		display: flex;
		gap: 4px;
	}

	.preview-dots span {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.15);
	}

	.light-card .preview-dots span {
		background: rgba(0, 0, 0, 0.15);
	}

	.preview-nav {
		display: flex;
		gap: 8px;
	}

	.preview-nav span {
		width: 24px;
		height: 4px;
		border-radius: 2px;
		background: rgba(255, 255, 255, 0.1);
	}

	.light-card .preview-nav span {
		background: rgba(0, 0, 0, 0.1);
	}

	.preview-hero {
		margin-bottom: 1rem;
	}

	.preview-name {
		width: 80%;
		height: 10px;
		border-radius: 3px;
		margin-bottom: 6px;
		background: linear-gradient(90deg, #00d4ff, #ff00aa);
		transition: background 0.6s ease;
	}

	.light-card .preview-name {
		background: linear-gradient(90deg, #c9a227, #1e3a8a);
	}

	.preview-subtitle {
		width: 50%;
		height: 6px;
		border-radius: 3px;
		margin-bottom: 10px;
		background: rgba(255, 255, 255, 0.1);
	}

	.light-card .preview-subtitle {
		background: rgba(0, 0, 0, 0.1);
	}

	.preview-buttons {
		display: flex;
		gap: 6px;
	}

	.preview-btn {
		height: 6px;
		border-radius: 3px;
	}

	.preview-btn.primary {
		width: 40px;
		background: linear-gradient(90deg, #00d4ff, #ff00aa);
		transition: background 0.6s ease;
	}

	.light-card .preview-btn.primary {
		background: linear-gradient(90deg, #c9a227, #1e3a8a);
	}

	.preview-btn.secondary {
		width: 30px;
		background: rgba(255, 255, 255, 0.08);
	}

	.light-card .preview-btn.secondary {
		background: rgba(0, 0, 0, 0.08);
	}

	.preview-cards {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 6px;
	}

	.preview-card {
		height: 40px;
		border-radius: 6px;
		background: rgba(255, 255, 255, 0.04);
		border: 1px solid rgba(255, 255, 255, 0.06);
		transition:
			background 0.6s ease,
			border-color 0.6s ease;
	}

	.light-card .preview-card {
		background: rgba(0, 0, 0, 0.02);
		border-color: rgba(0, 0, 0, 0.06);
	}

	.card-label {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		font-family: var(--font-heading);
		font-size: 1rem;
		font-weight: 600;
		color: var(--text-primary);
		transition: color 0.4s ease;
	}

	.dark-card:hover .card-label {
		color: #00d4ff;
	}

	.light-card:hover .card-label {
		color: #c9a227;
	}

	.card-icon {
		width: 20px;
		height: 20px;
	}

	@media (max-width: 640px) {
		.theme-cards {
			flex-direction: column;
			gap: 1rem;
		}

		.theme-card {
			width: 200px;
		}

		.card-preview {
			height: 140px;
		}

		.theme-modal-content {
			gap: 2rem;
			padding: 1rem;
		}
	}
</style>

<script is:inline>
	;(function () {
		const modal = document.getElementById("theme-modal")
		if (!modal) return

		const stored = localStorage.getItem("theme")
		if (stored) {
			modal.style.display = "none"
			return
		}

		const darkCard = modal.querySelector(".dark-card")
		const lightCard = modal.querySelector(".light-card")
		const preloader = document.getElementById("preloader")

		if (preloader) preloader.style.display = "none"
		document.documentElement.classList.add("modal-open")

		requestAnimationFrame(() => {
			modal.classList.add("visible")
			lightCard.dispatchEvent(new Event("mouseenter"))
		})

		darkCard.addEventListener("mouseenter", () => {
			modal.classList.remove("previewing-light")
			modal.classList.add("previewing-dark")
		})
		darkCard.addEventListener("mouseleave", () => modal.classList.remove("previewing-dark"))

		lightCard.addEventListener("mouseenter", () => {
			modal.classList.remove("previewing-dark")
			modal.classList.add("previewing-light")
		})
		lightCard.addEventListener("mouseleave", () => modal.classList.remove("previewing-light"))

		function selectTheme(theme) {
			localStorage.setItem("theme", theme)
			location.reload()
		}

		darkCard.addEventListener("click", () => selectTheme("dark"))
		lightCard.addEventListener("click", () => selectTheme("light"))
	})()
</script>

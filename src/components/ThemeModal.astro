---

---

<div class="theme-modal" id="theme-modal">
  <div class="theme-modal-bg"></div>

  <!-- Decorative floating elements -->
  <div class="decorations" aria-hidden="true">
    <!-- Top-left sparkle (gold) -->
    <svg class="deco deco-sparkle-gold-1" width="28" height="28" viewBox="0 0 28 28" fill="none">
      <path d="M14 0L16.5 11.5L28 14L16.5 16.5L14 28L11.5 16.5L0 14L11.5 11.5L14 0Z" fill="#C9A227"/>
    </svg>
    <!-- Top-right sparkle (blue) -->
    <svg class="deco deco-sparkle-blue-1" width="20" height="20" viewBox="0 0 28 28" fill="none">
      <path d="M14 0L16.5 11.5L28 14L16.5 16.5L14 28L11.5 16.5L0 14L11.5 11.5L14 0Z" fill="#1E3A8A"/>
    </svg>
    <!-- Small gold sparkle near title -->
    <svg class="deco deco-sparkle-gold-2" width="14" height="14" viewBox="0 0 28 28" fill="none">
      <path d="M14 0L16.5 11.5L28 14L16.5 16.5L14 28L11.5 16.5L0 14L11.5 11.5L14 0Z" fill="#C9A227"/>
    </svg>
    <!-- Pink heart -->
    <svg class="deco deco-heart" width="28" height="26" viewBox="0 0 28 26" fill="none">
      <path d="M14 26C14 26 0 18 0 8C0 3.6 3.6 0 8 0C10.4 0 12.6 1.2 14 3C15.4 1.2 17.6 0 20 0C24.4 0 28 3.6 28 8C28 18 14 26 14 26Z" stroke="#f472b6" stroke-width="1.5" fill="none"/>
    </svg>
    <!-- Sparkle between cards (gold) -->
    <svg class="deco deco-sparkle-mid" width="18" height="18" viewBox="0 0 28 28" fill="none">
      <path d="M14 0L16.5 11.5L28 14L16.5 16.5L14 28L11.5 16.5L0 14L11.5 11.5L14 0Z" fill="#C9A227"/>
    </svg>
    <!-- Right side gold sparkle -->
    <svg class="deco deco-sparkle-right" width="16" height="16" viewBox="0 0 28 28" fill="none">
      <path d="M14 0L16.5 11.5L28 14L16.5 16.5L14 28L11.5 16.5L0 14L11.5 11.5L14 0Z" fill="#C9A227"/>
    </svg>
    <!-- Dots cluster bottom-right -->
    <svg class="deco deco-dots" width="40" height="40" viewBox="0 0 40 40" fill="none">
      <circle cx="8" cy="8" r="2" fill="#1E3A8A" opacity="0.4"/>
      <circle cx="24" cy="12" r="1.5" fill="#C9A227" opacity="0.5"/>
      <circle cx="16" cy="28" r="2" fill="#1E3A8A" opacity="0.3"/>
      <circle cx="32" cy="24" r="1.5" fill="#C9A227" opacity="0.4"/>
      <circle cx="36" cy="8" r="1" fill="#f472b6" opacity="0.5"/>
    </svg>
    <!-- Dashed curve bottom-right -->
    <svg class="deco deco-dashed-curve" width="60" height="40" viewBox="0 0 60 40" fill="none">
      <path d="M5 35 Q30 5 55 20" stroke="#1E3A8A" stroke-width="1.5" stroke-dasharray="4 4" fill="none" opacity="0.4"/>
    </svg>
    <!-- Bottom-left sparkle (gold) -->
    <svg class="deco deco-sparkle-bl" width="18" height="18" viewBox="0 0 28 28" fill="none">
      <path d="M14 0L16.5 11.5L28 14L16.5 16.5L14 28L11.5 16.5L0 14L11.5 11.5L14 0Z" fill="#C9A227"/>
    </svg>
    <!-- Bottom-left dashed curve -->
    <svg class="deco deco-dashed-curve-bl" width="50" height="35" viewBox="0 0 50 35" fill="none">
      <path d="M45 30 Q20 5 5 20" stroke="#C9A227" stroke-width="1.5" stroke-dasharray="4 4" fill="none" opacity="0.35"/>
    </svg>
    <!-- Bottom-left dots -->
    <svg class="deco deco-dots-bl" width="30" height="30" viewBox="0 0 30 30" fill="none">
      <circle cx="6" cy="10" r="1.5" fill="#1E3A8A" opacity="0.35"/>
      <circle cx="18" cy="6" r="2" fill="#C9A227" opacity="0.4"/>
      <circle cx="12" cy="22" r="1.5" fill="#f472b6" opacity="0.3"/>
    </svg>
  </div>

  <div class="theme-modal-content">
    <!-- Header -->
    <div class="theme-modal-header">
      <h2 class="theme-modal-title">
        <svg class="title-sparkle title-sparkle-left" width="24" height="24" viewBox="0 0 28 28" fill="none" aria-hidden="true">
          <path d="M14 0L16.5 11.5L28 14L16.5 16.5L14 28L11.5 16.5L0 14L11.5 11.5L14 0Z" fill="#C9A227"/>
        </svg>
        <span class="title-text">¡Bienvenido!</span>
        <svg class="title-sparkle title-sparkle-right" width="18" height="18" viewBox="0 0 28 28" fill="none" aria-hidden="true">
          <path d="M14 0L16.5 11.5L28 14L16.5 16.5L14 28L11.5 16.5L0 14L11.5 11.5L14 0Z" fill="#1E3A8A"/>
        </svg>
      </h2>
      <div class="theme-modal-subtitle-wrapper">
        <p class="theme-modal-subtitle">
          La primera impresión también se diseña.<br/>
          Hagámoslo a tu manera ✨
        </p>
        <!-- Curved gold underline -->
        <svg class="subtitle-underline" width="180" height="16" viewBox="0 0 180 16" fill="none" aria-hidden="true">
          <path d="M10 8 Q50 2 90 8 Q130 14 170 8" stroke="#C9A227" stroke-width="2" fill="none" stroke-linecap="round"/>
          <circle cx="170" cy="8" r="3" fill="#C9A227"/>
        </svg>
      </div>
    </div>

    <!-- Theme cards -->
    <div class="theme-cards">
      <!-- Speech bubbles (positioned absolutely over hovered card) -->
      <div class="speech-bubble speech-bubble-dark" aria-hidden="true">^^</div>
      <div class="speech-bubble speech-bubble-light" aria-hidden="true">^^</div>

      <!-- Dark card -->
      <button class="theme-card dark-card" data-theme="dark" aria-label="Modo Nocturno">
        <div class="card-preview">
          <div class="preview-header">
            <div class="preview-dots">
              <span></span><span></span><span></span>
            </div>
            <div class="preview-nav">
              <span></span><span></span><span></span>
            </div>
          </div>
          <div class="preview-hero">
            <div class="preview-hero-bar"></div>
          </div>
          <div class="preview-cards">
            <div class="preview-card"></div>
            <div class="preview-card"></div>
            <div class="preview-card"></div>
          </div>
        </div>
        <div class="card-label">
          <svg class="card-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
          <span>Modo Nocturno</span>
        </div>
      </button>

      <!-- Light card -->
      <button class="theme-card light-card" data-theme="light" aria-label="Modo Lumina">
        <div class="card-preview">
          <div class="preview-header">
            <div class="preview-dots">
              <span></span><span></span><span></span>
            </div>
            <div class="preview-nav">
              <span></span><span></span><span></span>
            </div>
          </div>
          <div class="preview-hero">
            <div class="preview-hero-bar"></div>
          </div>
          <div class="preview-cards">
            <div class="preview-card"></div>
            <div class="preview-card"></div>
            <div class="preview-card"></div>
          </div>
        </div>
        <div class="card-label">
          <svg class="card-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="5"></circle>
            <line x1="12" y1="1" x2="12" y2="3"></line>
            <line x1="12" y1="21" x2="12" y2="23"></line>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
            <line x1="1" y1="12" x2="3" y2="12"></line>
            <line x1="21" y1="12" x2="23" y2="12"></line>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
          </svg>
          <span>Modo Lumina</span>
        </div>
      </button>
    </div>

    <!-- Bottom text -->
    <div class="theme-modal-footer">
      <p class="footer-text">
        ¡La experiencia comienza contigo!
        <span class="footer-rocket">🚀</span>
      </p>
      <!-- Curved underline -->
      <svg class="footer-underline" width="220" height="12" viewBox="0 0 220 12" fill="none" aria-hidden="true">
        <path d="M10 6 Q60 12 110 6 Q160 0 210 6" stroke="#1E3A8A" stroke-width="1.5" fill="none" stroke-linecap="round"/>
      </svg>
    </div>
  </div>
</div>

<style>
  /* ── Modal base ── */
  .theme-modal {
    position: fixed;
    inset: 0;
    z-index: 10000;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.4s ease,
      visibility 0.4s ease;
  }

  .theme-modal.visible {
    opacity: 1;
    visibility: visible;
  }

  .theme-modal.exiting {
    pointer-events: none;
  }

  .theme-modal.exiting .theme-modal-content {
    animation: modalContentExit 0.5s ease forwards;
  }

  @keyframes modalContentExit {
    0% { transform: scale(1); opacity: 1; }
    100% { transform: scale(0.95); opacity: 0; }
  }

  /* ── Background ── */
  .theme-modal-bg {
    position: absolute;
    inset: 0;
    background: #f5f5f0;
    transition: background 0.6s ease;
  }

  .theme-modal.previewing-dark .theme-modal-bg {
    background: #0a0a0f;
  }

  .theme-modal.previewing-light .theme-modal-bg {
    background: #f5f5f0;
  }

  /* ── Floating decorations ── */
  .decorations {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }

  .deco {
    position: absolute;
    opacity: 0;
    animation: decoFadeIn 0.6s ease forwards;
  }

  @keyframes decoFadeIn {
    to { opacity: 1; }
  }

  .deco-sparkle-gold-1 {
    top: 8%;
    left: 18%;
    animation-delay: 0.3s;
    animation: decoFadeIn 0.6s ease 0.3s forwards, decoFloat 4s ease-in-out 0.9s infinite;
  }

  .deco-sparkle-blue-1 {
    top: 10%;
    right: 20%;
    animation-delay: 0.4s;
    animation: decoFadeIn 0.6s ease 0.4s forwards, decoFloat 4.5s ease-in-out 1s infinite;
  }

  .deco-sparkle-gold-2 {
    top: 18%;
    left: 28%;
    animation-delay: 0.5s;
    animation: decoFadeIn 0.6s ease 0.5s forwards, decoFloat 3.5s ease-in-out 1.1s infinite;
  }

  .deco-heart {
    top: 28%;
    right: 18%;
    animation-delay: 0.6s;
    animation: decoFadeIn 0.6s ease 0.6s forwards, decoFloat 5s ease-in-out 1.2s infinite;
  }

  .deco-sparkle-mid {
    top: 52%;
    left: 50%;
    transform: translateX(-50%);
    animation-delay: 0.5s;
    animation: decoFadeIn 0.6s ease 0.5s forwards, decoPulse 3s ease-in-out 1.1s infinite;
  }

  .deco-sparkle-right {
    top: 60%;
    right: 15%;
    animation-delay: 0.7s;
    animation: decoFadeIn 0.6s ease 0.7s forwards, decoFloat 4s ease-in-out 1.3s infinite;
  }

  .deco-dots {
    bottom: 18%;
    right: 12%;
    animation-delay: 0.8s;
  }

  .deco-dashed-curve {
    bottom: 14%;
    right: 10%;
    animation-delay: 0.9s;
  }

  .deco-sparkle-bl {
    bottom: 18%;
    left: 12%;
    animation-delay: 1s;
    animation: decoFadeIn 0.6s ease 1s forwards, decoFloat 4s ease-in-out 1.6s infinite;
  }

  .deco-dashed-curve-bl {
    bottom: 12%;
    left: 10%;
    animation-delay: 1.1s;
  }

  .deco-dots-bl {
    bottom: 22%;
    left: 18%;
    animation-delay: 1.2s;
  }

  @keyframes decoFloat {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-6px); }
  }

  @keyframes decoPulse {
    0%, 100% { transform: translateX(-50%) scale(1); opacity: 0.8; }
    50% { transform: translateX(-50%) scale(1.15); opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .deco { animation: decoFadeIn 0.6s ease forwards !important; }
    .deco-sparkle-gold-1, .deco-sparkle-blue-1, .deco-sparkle-gold-2,
    .deco-heart, .deco-sparkle-mid, .deco-sparkle-right {
      animation: decoFadeIn 0.6s ease forwards !important;
    }
  }

  /* ── Content ── */
  .theme-modal-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2.5rem;
    padding: 2rem;
    max-width: 700px;
    width: 100%;
  }

  /* ── Header ── */
  .theme-modal-header {
    text-align: center;
  }

  .theme-modal-title {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 700;
    margin: 0 0 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    line-height: 1.2;
  }

  .title-text {
    background: linear-gradient(135deg, #C9A227, #1E3A8A);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .theme-modal.previewing-dark .title-text {
    background: linear-gradient(135deg, #00d4ff, #ff00aa);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .title-sparkle {
    flex-shrink: 0;
  }

  .title-sparkle-left {
    animation: sparkleRotate 3s ease-in-out infinite;
  }

  .title-sparkle-right {
    animation: sparkleRotate 3.5s ease-in-out 0.5s infinite;
  }

  @keyframes sparkleRotate {
    0%, 100% { transform: rotate(0deg) scale(1); }
    50% { transform: rotate(15deg) scale(1.1); }
  }

  @media (prefers-reduced-motion: reduce) {
    .title-sparkle-left, .title-sparkle-right {
      animation: none;
    }
  }

  .theme-modal-subtitle-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .theme-modal-subtitle {
    font-size: clamp(0.9rem, 2vw, 1.1rem);
    color: #57534e;
    margin: 0;
    line-height: 1.7;
    transition: color 0.6s ease;
  }

  .theme-modal.previewing-dark .theme-modal-subtitle {
    color: #a0a0b0;
  }

  .subtitle-underline {
    display: block;
  }

  /* ── Cards ── */
  .theme-cards {
    display: flex;
    gap: 2.5rem;
    align-items: stretch;
    position: relative;
  }

  .theme-card {
    position: relative;
    width: 280px;
    background: rgba(255, 255, 255, 0.6);
    border: 2px solid transparent;
    border-radius: 20px;
    padding: 1rem;
    cursor: pointer;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    overflow: visible;
    font-family: inherit;
  }

  .dark-card {
    background: rgba(30, 30, 40, 0.06);
    border-color: rgba(255, 255, 255, 0.08);
  }

  .dark-card:hover {
    transform: translateY(-8px) scale(1.02);
    box-shadow: 0 20px 60px rgba(0, 212, 255, 0.2);
    background: rgba(30, 30, 40, 0.12);
  }

  .light-card {
    border-color: #C9A227;
    transform: translateY(-4px);
    box-shadow: 0 12px 40px rgba(201, 162, 39, 0.15);
    background: rgba(255, 255, 255, 0.85);
  }

  .light-card:hover {
    transform: translateY(-8px) scale(1.02);
    box-shadow: 0 20px 60px rgba(201, 162, 39, 0.25);
    border-color: #b8921f;
  }

  /* ── Speech bubble ── */
  .speech-bubble {
    position: absolute;
    top: -14px;
    background: #fafafa;
    border: 2px solid #C9A227;
    border-radius: 12px;
    padding: 4px 10px;
    font-size: 0.85rem;
    font-weight: 600;
    color: #C9A227;
    z-index: 2;
    box-shadow: 0 2px 8px rgba(201, 162, 39, 0.15);
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.3s ease, transform 0.3s ease;
    pointer-events: none;
  }

  .speech-bubble::after {
    content: '';
    position: absolute;
    bottom: -8px;
    left: 16px;
    width: 0;
    height: 0;
    border-left: 6px solid transparent;
    border-right: 6px solid transparent;
    border-top: 8px solid #C9A227;
  }

  .speech-bubble-dark {
    right: calc(50% + 2.5rem + 10px);
  }

  .speech-bubble-light {
    left: calc(50% + 2.5rem + 10px);
  }

  .theme-modal.previewing-dark .speech-bubble-dark {
    opacity: 1;
    transform: translateY(0);
    border-color: #00d4ff;
    color: #00d4ff;
    background: #1a1a2e;
  }

  .theme-modal.previewing-dark .speech-bubble-dark::after {
    border-top-color: #00d4ff;
  }

  .theme-modal.previewing-light .speech-bubble-light {
    opacity: 1;
    transform: translateY(0);
  }

  /* ── Card preview ── */
  .card-preview {
    background: #1a1a2e;
    border-radius: 14px;
    padding: 0.875rem;
    margin-bottom: 1rem;
    height: 180px;
    overflow: hidden;
    transition: background 0.6s ease;
  }

  .light-card .card-preview {
    background: #fafafa;
  }

  .preview-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.25rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .light-card .preview-header {
    border-bottom-color: rgba(0, 0, 0, 0.06);
  }

  .preview-dots {
    display: flex;
    gap: 5px;
  }

  .preview-dots span {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.15);
  }

  .light-card .preview-dots span {
    background: rgba(0, 0, 0, 0.15);
  }

  .preview-nav {
    display: flex;
    gap: 6px;
  }

  .preview-nav span {
    width: 22px;
    height: 4px;
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.08);
  }

  .light-card .preview-nav span {
    background: rgba(0, 0, 0, 0.08);
  }

  .preview-hero {
    margin-bottom: 1.25rem;
  }

  .preview-hero-bar {
    width: 85%;
    height: 10px;
    border-radius: 5px;
    background: linear-gradient(90deg, #00d4ff, #a855f7, #ff00aa);
    transition: background 0.6s ease;
  }

  .light-card .preview-hero-bar {
    background: linear-gradient(90deg, #C9A227, #1E3A8A);
  }

  .preview-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
  }

  .preview-card {
    height: 44px;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.06);
    transition: background 0.6s ease, border-color 0.6s ease;
  }

  .light-card .preview-card {
    background: #ffffff;
    border-color: rgba(0, 0, 0, 0.06);
  }

  /* ── Card label ── */
  .card-label {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 600;
    color: #1c1917;
    transition: color 0.4s ease;
  }

  .dark-card .card-label {
    color: #1c1917;
  }

  .dark-card:hover .card-label {
    color: #00d4ff;
  }

  .light-card:hover .card-label {
    color: #C9A227;
  }

  .card-icon {
    width: 20px;
    height: 20px;
  }

  /* ── Footer ── */
  .theme-modal-footer {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
  }

  .footer-text {
    font-size: clamp(0.9rem, 2vw, 1.05rem);
    font-style: italic;
    color: #57534e;
    margin: 0;
    transition: color 0.6s ease;
  }

  .theme-modal.previewing-dark .footer-text {
    color: #a0a0b0;
  }

  .footer-rocket {
    display: inline-block;
    animation: rocketBounce 2s ease-in-out infinite;
  }

  @keyframes rocketBounce {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-4px) rotate(5deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-rocket { animation: none; }
  }

  .footer-underline {
    display: block;
  }

  /* ── Touch devices: hide hover-dependent speech bubble ── */
  @media (hover: none), (pointer: coarse) {
    .speech-bubble { display: none; }
  }

  /* ── Responsive ── */
  @media (max-width: 640px) {
    .theme-cards {
      flex-direction: column;
      gap: 1.5rem;
      align-items: center;
    }

    .theme-card {
      width: 260px;
    }

    .card-preview {
      height: 150px;
    }

    .theme-modal-content {
      gap: 2rem;
      padding: 1.5rem 1rem;
    }

    .deco-sparkle-gold-1 { left: 5%; top: 5%; }
    .deco-sparkle-blue-1 { right: 8%; top: 8%; }
    .deco-sparkle-gold-2 { left: 15%; top: 15%; }
    .deco-heart { right: 8%; top: 25%; }
    .deco-sparkle-mid { display: none; }
    .deco-sparkle-right { right: 5%; top: 55%; }
    .deco-dots { bottom: 10%; right: 5%; }
    .deco-dashed-curve { display: none; }
    .deco-sparkle-bl { bottom: 10%; left: 5%; }
    .deco-dashed-curve-bl { display: none; }
    .deco-dots-bl { bottom: 15%; left: 8%; }

    .speech-bubble {
      top: -12px;
      font-size: 0.75rem;
      padding: 3px 8px;
    }

    .speech-bubble-dark {
      right: calc(50% + 1.25rem + 8px);
    }

    .speech-bubble-light {
      left: calc(50% + 1.25rem + 8px);
    }
  }
</style>

<script is:inline>
  ;(function () {
    const modal = document.getElementById("theme-modal")
    if (!modal) return

    const stored = localStorage.getItem("theme")
    if (stored) {
      modal.style.display = "none"
      return
    }

    const darkCard = modal.querySelector(".dark-card")
    const lightCard = modal.querySelector(".light-card")
    const preloader = document.getElementById("preloader")

    if (preloader) preloader.style.display = "none"
    document.documentElement.classList.add("modal-open")

    requestAnimationFrame(() => {
      modal.classList.add("visible")
      modal.classList.add("previewing-light")
    })

    darkCard.addEventListener("mouseenter", () => {
      modal.classList.remove("previewing-light")
      modal.classList.add("previewing-dark")
    })
    darkCard.addEventListener("mouseleave", () => modal.classList.remove("previewing-dark"))

    lightCard.addEventListener("mouseenter", () => {
      modal.classList.remove("previewing-dark")
      modal.classList.add("previewing-light")
    })
    lightCard.addEventListener("mouseleave", () => modal.classList.remove("previewing-light"))

    function selectTheme(theme) {
      localStorage.setItem("theme", theme)
      location.reload()
    }

    darkCard.addEventListener("click", () => selectTheme("dark"))
    lightCard.addEventListener("click", () => selectTheme("light"))
  })()
</script>

---
import ProjectCard from "./ProjectCard.astro"

const projects = [
	{
		title: "Ecosistema FinTech Multi-Tenant",
		description:
			"Software que facilita la venta en línea sin necesidad de contar con un sitio web. La comodidad de pagar a distancia o a través de tus redes sociales con sus tarjetas Visa, Mastercard o utilizando sus billeteras digitales. Crea, comparte y recibe tus pagos.",
		tags: [
			"PHP",
			"Javascript",
			"Composer",
			"Bootstrap",
			"MySQL",
			"Git",
			"Payment Gateways",
			"Digital Wallets",
			"DTE/FEL",
			"SMS",
			"Dashboards",
			"Notificaciones",
		],
		images: [
			"/images/projects/1/hosted-checkout-v1-adm.svg",
			"/images/projects/1/hosted-checkout-v1-checkout.svg",
			"/images/projects/1/hosted-checkout-v2-checkout.svg",
			"/images/projects/1/hosted-checkout-v1-checkout.svg",
		],
		featured: true,
		confidential: true,
	},
    {
		title: "Sistema de Gestión Financiera",
		description:
			"Aplicación web para la administración de finanzas personales o empresariales, con control de ingresos y egresos, cálculo de balances, panel de indicadores financieros, recordatorios de pagos y notificaciones automáticas por correo electrónico.Panel de control financiero. Control de ingresos, egresos, balance general, recordatorios y notificaciones por correo.",
		tags: ["PHP", "JavaScript", "MySQL", "Composer", "Git", "Bootstrap"],
		image: "/images/projects/3/finanzas-demo.svg",
		confidential: true,
	},
	{
		title: "Plataforma de Comercio Electrónico (E-commerce)",
		description:
			"Aplicación web para la gestión de catálogo de productos, carrito de compras, proceso de checkout, órdenes, inventario, usuarios y pagos, con panel administrativo para la gestión comercial.",
		tags: ["Laravel", "React", "PostgreSQL", "Vite", "Nginx", "Tailwind CSS", "Docker", "pnpm", "Turborepo"],
		image: "/images/projects/2/ecommerce-demo.svg",
		github: "https://github.com/kevin-villatoro-dev/carro-de-compras",
	},
	{
		title: "API Gateway y Capa de Integración de Servicios",
		description:
			"Servicio intermediario para centralizar el acceso a múltiples APIs, gestionar autenticación, autorización, enrutamiento de solicitudes, rate limiting, monitoreo y consolidación de respuestas entre servicios internos y externos.",
		tags: ["React", "Fastify", "Typescript", "JWT"],
		image: "/images/projects/4/api-gateway-demo.svg",
		github: "https://github.com/kevin-villatoro-dev/api-gateway",
	},
	{
		title: "Sistema de Gestión de Postulaciones (Job Tracker)",
		description:
			"Aplicación web para administrar postulaciones laborales, seguimiento por etapas del proceso de selección, registro de empresas, entrevistas, estados y motivos de cierre.",
		tags: ["Workflow Management", "Typescript", "Shadcn", "Tailwind"],
		image: "/images/projects/5/placeholder.png",
	},
	{
		title: "Plataforma de Aprendizaje Continuo (LMS)",
		description:
			"Aplicación web para la gestión y consumo de cursos, módulos de aprendizaje, seguimiento de progreso, evaluaciones y administración de contenido educativo.",
		tags: ["React", "Fastify", "Typescript", "JWT"],
		images: [
			"/images/projects/6/inicio.png",
			"/images/projects/6/buscador.png",
			"/images/projects/6/detalle.png",
			"/images/projects/6/filtros.png",
		],
	},
]

const featuredProjects = projects.filter((p) => p.featured)
const otherProjects = projects.filter((p) => !p.featured)
---

<section id="proyectos" class="projects section">
	<div class="container">
		<div class="section-title">
			<h2>Proyectos <span class="gradient-text">destacados</span></h2>
			<p>Una selección de proyectos que demuestra la forma en que resuelvo problemas reales y reflejan mi experiencia</p>
		</div>

		<div class="projects-hero-grid">
			{featuredProjects.map((project) => <ProjectCard {...project} layout="hero" />)}
		</div>

		{
			otherProjects.length > 0 && (
				<div class="projects-compact-grid">
					{otherProjects.map((project) => (
						<ProjectCard {...project} layout="compact" />
					))}
				</div>
			)
		}
		<div class="section-cta">
			<a href="#contacto" aria-label="Ir a contacto">
				<svg
					xmlns="http://www.w3.org/2000/svg"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg
				>
			</a>
		</div>
	</div>
</section>

<style>
	/* ── Hero grid: full-width horizontal cards ── */
	.projects-hero-grid {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
		margin-bottom: 2rem;
	}

	/* ── Compact grid: smaller cards below ── */
	.projects-compact-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.5rem;
	}

	@media (max-width: 1024px) {
		.projects-compact-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 768px) {
		.projects-compact-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
